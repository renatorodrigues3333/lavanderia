# Copie este arquivo para "application-local.properties" (na mesma pasta, ao lado do pom.xml)
# e troque os valores. O arquivo application-local.properties NUNCA vai para o GitHub.

# Senha do administrador (mínimo 8 caracteres). Só é usada na primeira vez, para criar o administrador.
lavamais.admin.senha=TROQUE_POR_UMA_SENHA_FORTE

# Chave que assina os tokens de login (mínimo 32 caracteres, aleatória).
lavamais.jwt.secret=TROQUE_POR_UMA_CHAVE_ALEATORIA_COM_PELO_MENOS_32_CARACTERES
