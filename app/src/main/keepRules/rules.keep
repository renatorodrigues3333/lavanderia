# Add project specific R8 rules here.
# AGP will combine all keep rule files in src/main/keepRules to pass to R8
#
# For more details, see
#   https://d.android.com/r/tools/r8/keep-rules

# If your project uses WebView with JS, uncomment the following
# and specify the fully qualified class name to the JavaScript interface
# class:
#-keepclassmembers class fqcn.of.javascript.interface.for.webview {
#   public *;
#}

# Modelos da API (ApiModelos.kt): o Gson usa o nome dos campos para ler/gravar o JSON,
# então eles não podem ser renomeados nem removidos pelo R8.
-keep class com.equipe.lavemais.LoginRequest { *; }
-keep class com.equipe.lavemais.RegisterRequest { *; }
-keep class com.equipe.lavemais.UsuarioApi { *; }
-keep class com.equipe.lavemais.AtualizarPerfilRequest { *; }
-keep class com.equipe.lavemais.AuthResponse { *; }
-keep class com.equipe.lavemais.MaquinaApi { *; }
-keep class com.equipe.lavemais.ServicoApi { *; }
-keep class com.equipe.lavemais.NovaUtilizacaoRequest { *; }
-keep class com.equipe.lavemais.PagamentoRequest { *; }
-keep class com.equipe.lavemais.UtilizacaoApi { *; }
-keep class com.equipe.lavemais.MensagemResponse { *; }
